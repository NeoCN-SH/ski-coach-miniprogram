.detail { padding-bottom: 150rpx; }
.profile-hero { padding: 44rpx 30rpx 36rpx; text-align: center; color: #fff; background: linear-gradient(160deg, #0b3986, #176bff 70%, #68b7ff); }
.avatar { width: 150rpx; height: 150rpx; margin: auto; display: flex; align-items: center; justify-content: center; border: 6rpx solid rgba(255,255,255,.4); border-radius: 44rpx; background: rgba(255,255,255,.2); font-size: 46rpx; font-weight: 700; }
.name { margin-top: 20rpx; font-size: 42rpx; font-weight: 700; }
.name text { font-size: 21rpx; color: #d8edff; font-weight: 400; }
.level { margin-top: 10rpx; opacity: .82; }
.stats { display: flex; margin-top: 38rpx; padding-top: 28rpx; border-top: 1rpx solid rgba(255,255,255,.18); }
.stats view { flex: 1; display: flex; flex-direction: column; border-right: 1rpx solid rgba(255,255,255,.18); }
.stats view:last-child { border: 0; }
.stats .stat-value { font-size: 30rpx; font-weight: 700; }
.stats text { margin-top: 7rpx; font-size: 20rpx; opacity: .72; }
.content { padding: 24rpx 28rpx; }
.block { padding: 28rpx; margin-bottom: 20rpx; }
.block-title { margin-bottom: 18rpx; font-size: 30rpx; font-weight: 700; }
.intro { color: #59687a; line-height: 1.8; }
.days { display: flex; gap: 14rpx; }
.day { padding: 16rpx 20rpx; color: #176bff; background: #edf4ff; border-radius: 16rpx; }
.service { color: #59687a; line-height: 2; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; height: 126rpx; padding: 14rpx 24rpx 22rpx; box-sizing: border-box; display: flex; align-items: center; gap: 18rpx; background: #fff; box-shadow: 0 -10rpx 30rpx rgba(20,42,72,.08); }
.mini-action { width: 70rpx; color: #647286; text-align: center; font-size: 20rpx; }
.mini-action text { display: block; color: #176bff; font-size: 34rpx; }
.price { margin-left: auto; color: #f05d3d; font-size: 34rpx; font-weight: 700; }
.price text, .price .price-unit { font-size: 20rpx; font-weight: 400; }
.book { margin: 0; padding: 0 28rpx; color: #fff; background: #176bff; border-radius: 999rpx; font-size: 26rpx; }
.book::after { border: 0; }
