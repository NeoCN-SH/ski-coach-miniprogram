.search { height: 84rpx; padding: 0 26rpx; display: flex; align-items: center; }
.search-icon { color: #176bff; font-size: 40rpx; margin-right: 16rpx; }
.search input { flex: 1; }
.filters { margin: 26rpx 0 16rpx; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 14rpx; }
.subfilters { display: flex; gap: 14rpx; margin-bottom: 30rpx; }
.filter, .available-filter { display: inline-block; padding: 15rpx 26rpx; color: #637184; background: #fff; border-radius: 999rpx; font-size: 24rpx; }
.filter.active, .available-filter.active { color: #fff; background: #176bff; }
.result-count { color: #778598; font-size: 24rpx; margin-bottom: 18rpx; }
.empty { text-align: center; padding: 100rpx 0; line-height: 2; }
.empty-icon { font-size: 80rpx; }
