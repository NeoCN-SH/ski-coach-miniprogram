<view class="page">
  <view class="hero">
    <view class="eyebrow">SKI BETTER · 滑得更好</view>
    <view class="hero-title">找到懂你的<text>双板教练</text></view>
    <view class="hero-desc">认证信息 · 真实评价 · 透明价格</view>
    <button class="search-button" bindtap="goCoaches">搜索雪场、教练或课程</button>
    <view class="mountain">╱╲　╱╲╱╲</view>
  </view>

  <view class="section-title">热门雪区</view>
  <view class="resort-list">
    <view class="resort-card card" wx:for="{{resorts}}" wx:key="name" data-name="{{item.name}}" bindtap="chooseResort">
      <view class="resort-icon">{{item.icon}}</view>
      <view class="resort-name">{{item.name}}</view>
      <view class="muted resort-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title">精选教练</view>
    <view class="more" bindtap="goCoaches">查看全部 ›</view>
  </view>
  <coach-card wx:for="{{featured}}" wx:key="id" coach="{{item}}" favorite="{{favoriteMap[item.id]}}" bind:favorite="toggleFavorite" />
</view>
