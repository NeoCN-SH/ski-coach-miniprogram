.hero {
  position: relative; overflow: hidden; min-height: 360rpx; box-sizing: border-box;
  padding: 44rpx 36rpx; color: #fff; border-radius: 36rpx;
  background: linear-gradient(145deg, #0e3e91 0%, #176bff 52%, #69b7ff 100%);
  box-shadow: 0 22rpx 50rpx rgba(23, 107, 255, .22);
}
.eyebrow { font-size: 20rpx; letter-spacing: 4rpx; opacity: .82; }
.hero-title { width: 420rpx; margin-top: 18rpx; font-size: 52rpx; line-height: 1.25; font-weight: 800; }
.hero-title text { display: block; color: #bde8ff; }
.hero-desc { margin-top: 16rpx; font-size: 24rpx; opacity: .85; }
.search-button { margin: 28rpx 0 0; width: 420rpx; height: 72rpx; line-height: 72rpx; border-radius: 999rpx; color: #60728a; background: #fff; font-size: 24rpx; text-align: left; padding-left: 30rpx; }
.search-button::after { border: 0; }
.mountain { position: absolute; right: -18rpx; bottom: -10rpx; font-size: 98rpx; color: rgba(255,255,255,.18); transform: rotate(-8deg); }
.resort-list { display: flex; gap: 18rpx; }
.resort-card { flex: 1; padding: 22rpx 16rpx; text-align: center; }
.resort-icon { font-size: 44rpx; }
.resort-name { margin-top: 8rpx; font-weight: 700; }
.resort-desc { margin-top: 4rpx; font-size: 20rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.more { color: #176bff; margin-top: 18rpx; font-size: 24rpx; }
