<view class="page">
  <view wx:if="{{list.length}}">
    <view class="title">心动教练</view>
    <view class="muted subtitle">收藏不会错过合适的雪上搭档</view>
    <coach-card wx:for="{{list}}" wx:key="id" coach="{{item}}" favorite="{{true}}" bind:favorite="toggleFavorite" />
  </view>
  <view class="empty" wx:else>
    <view class="icon">♡</view>
    <view class="empty-title">还没有收藏教练</view>
    <view class="muted">遇到合适的教练，点亮爱心收藏吧</view>
    <button class="primary-button" bindtap="goCoaches">去找教练</button>
  </view>
</view>
